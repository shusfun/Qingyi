{
  "name": "qingyi-extension",
  "version": "3.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "release": "node scripts/release.mjs",
    "format": "prettier --write src tests scripts static README.md package.json",
    "format:check": "prettier --check src tests scripts static README.md package.json"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "3.54.1-build1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.6.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
