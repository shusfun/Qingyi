{
  "name": "qingyi-extension",
  "version": "3.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync": "node scripts/sync-shared.mjs",
    "sync:check": "node scripts/sync-shared.mjs --check",
    "check": "node scripts/sync-shared.mjs --check && tsc --noEmit",
    "build": "node scripts/build.mjs",
    "test": "node --import tsx --test tests/*.test.ts scripts/*.test.mjs",
    "release": "node scripts/release.mjs",
    "format": "prettier --write design-system shared src tests scripts static options.html pdf.html vite.config.ts README.md package.json",
    "format:check": "prettier --check design-system shared src tests scripts static options.html pdf.html vite.config.ts README.md package.json"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "3.54.1-build1",
    "pdfjs-dist": "^4.10.38",
    "preact": "^10.25.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.6.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^6.2.0"
  }
}
